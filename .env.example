# Copy to .env.local (gitignored) and fill in. On Vercel, set the same values
# in Project → Settings → Environment Variables.
#
# Web3Forms access key for the /api/contact route (Contact room form).
# Get a free key at https://web3forms.com — the route refuses to send mail
# without it and responds 500 {"message":"Web3Forms key is missing."}.
WEB3FORMS_KEY=
